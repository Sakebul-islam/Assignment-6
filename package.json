{
  "name": "roommate-hub-backend",
  "version": "1.0.0",
  "description": "RoomMate Hub - Housing & Roommate Platform API",
  "private": true,
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.4.0",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/newman": "^5.3.6",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "newman": "^6.2.3",
    "prisma": "7.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "seed": "tsx src/app/utils/seed.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "gate": "bun run typecheck && bun run check && bun run build",
    "test:api": "tsx src/app/scripts/runApiTests.ts local",
    "test:api:prod": "tsx src/app/scripts/runApiTests.ts production",
    "test:webhook": "tsx src/app/scripts/sendTestWebhook.ts",
    "test:race": "tsx src/app/scripts/raceTest.ts",
    "test:consistency": "tsx src/app/scripts/checkConsistency.ts",
    "stripe:listen": "tsx src/app/scripts/stripeListen.ts"
  }
}
