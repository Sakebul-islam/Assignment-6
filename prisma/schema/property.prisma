model Property {
  id              String         @id @default(uuid(7))
  ownerId         String
  title           String         @db.VarChar(150)
  description     String         @db.VarChar(3000)
  city            String         @db.VarChar(60)
  area            String         @db.VarChar(80)
  address         String         @db.VarChar(255)
  amenities       Amenity[]
  houseRules      String?        @db.VarChar(1000)
  status          PropertyStatus @default(PENDING)
  rejectionReason String?        @db.VarChar(300)
  reviewedById    String?
  reviewedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  owner      User            @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("PropertyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  images     PropertyImage[]
  rooms      Room[]

  @@index([ownerId])
  @@index([status, city, area])
  @@index([deletedAt])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid(7))
  propertyId String
  url        String
  publicId   String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime? // soft delete

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}
