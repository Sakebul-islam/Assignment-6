model Application {
  id              String            @id @default(uuid(7))
  roomId          String
  tenantId        String
  moveInDate      DateTime          @db.Date
  message         String?           @db.VarChar(500)
  status          ApplicationStatus @default(PENDING)
  quotedRent      Decimal?          @db.Decimal(10, 2) // price locked when the owner approves
  quotedDeposit   Decimal?          @db.Decimal(10, 2)
  reservedUntil   DateTime?
  rejectionReason String?           @db.VarChar(300)
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenant   User      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenancy  Tenancy?
  payments Payment[]

  @@index([roomId, status])
  @@index([tenantId, status])
  @@index([status, reservedUntil])
  @@map("applications")
}
