NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

# Local PostgreSQL: replace YOUR_POSTGRES_PASSWORD with your postgres user password
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/roommate_hub?schema=public

# Leave empty to run without Redis locally (no cache, in-memory rate limit). Use Upstash in production.
REDIS_URL=

BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=replace-with-64-random-hex-characters
JWT_ACCESS_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_DAYS=7

# Google Cloud OAuth client ID (Web application)
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=bdt
RESERVATION_HOURS=48

# Requests per 15 minutes per IP (defaults 300 and 10). Raise only locally for long test runs.
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=10

# Demo accounts created by: bun run seed
SEED_ADMIN_EMAIL=admin@roommatehub.com
SEED_ADMIN_PASSWORD=replace-me
SEED_DEMO_PASSWORD=replace-me
